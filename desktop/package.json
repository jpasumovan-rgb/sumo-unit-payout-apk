{
  "name": "sumo-unit-payout",
  "productName": "SUMO Unit Payout",
  "version": "1.0.0",
  "description": "SUMOVAN Unit Payout - payout and driver salary for operators",
  "author": "SUMOVAN LOGISTICS CORP.",
  "main": "main.js",
  "scripts": { "start": "electron ." },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "ph.sumovan.unitpayout",
    "productName": "SUMO Unit Payout",
    "files": ["main.js", "icon.png"],
    "win": { "target": "nsis", "icon": "icon.png" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SUMO Unit Payout",
      "artifactName": "SUMO-Unit-Payout-Setup.exe"
    }
  }
}
